# Copy to .env and fill in. .env is ignored by git.

# Supabase project (Project Settings -> API). With these two set, sign-in goes through Supabase Auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional, server only, never put it in the browser: lets admins create users, change roles
# and reset passwords from the console. Without it, do those in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# PORT=8080
# MQTT_BROKERS=mqtt://broker.emqx.io:1883,mqtt://broker.hivemq.com:1883
